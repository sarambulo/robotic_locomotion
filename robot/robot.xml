<mujoco>
  <compiler angle="radian"/>
  <option timestep="0.01"/>
  
  <worldbody>
    <!-- Static base -->
    <body name="base" pos="0 0 0">
      <geom type="box" size="0.1 0.1 0.1" rgba="0.3 0.3 0.3 1"/>
    </body>
    
    <!-- Rotating arm (pendulum) -->
    <body name="arm" pos="0 0 0">
      <joint name="hinge" type="hinge" axis="0 1 0"/>
      <geom type="cylinder" size="0.05" fromto="0 0 0 0 0.5 0" rgba="0.8 0.2 0.2 1"/>
      <geom type="capsule" size="0.05 0.1" pos="0 0.5 0" rgba="0.8 0.2 0.2 1"/>
    </body>
  </worldbody>
  
  <actuator>
    <motor name="motor" joint="hinge" gear="1"/>
  </actuator>
</mujoco>
